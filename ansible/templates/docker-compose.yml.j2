{% set tag = env ~ '_' ~ version if version is defined and version != '' else env %}

version: '3.3'
services:
{% if version is defined and version != '' %}
  deployment_api_{{tag}}:
{% else %}
  deployment_api:
{% endif %}
    image: {{ lookup('vars', org + '_haproxy_image_' + env)}}/nexops/deployment-api:{{tag}}-latest
    deploy:
      mode: replicated
      endpoint_mode: dnsrr
      replicas: 3
      placement:
        constraints:
          - node.labels.NEXOPS_LOW_STORAGE == yes
    networks:
      - swarm_{{org | lower}}_{{env | lower}}
networks:
  swarm_{{org | lower}}_{{env | lower}}:
    external: true
