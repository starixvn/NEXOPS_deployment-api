{% set tag = env ~ '_' ~ version if version is defined and version != '' else env %}

version: '3.3'
services:
{% if version is defined and version != '' %}
  deployment_api_{{tag}}:
{% else %}
  deployment_api:
{% endif %}
    image: {{ lookup('vars', org + '_deploymentapi_image_' + env) }}/nexops/deployment-api:{{tag}}-latest
{% if public_port is defined and public_port != '' %}
    ports:
      - target: 22222
        published: {{public_port}}
        protocol: tcp
        #mode: host
{% endif %}
    deploy:
      mode: replicated
      #endpoint_mode: dnsrr
      replicas: {{replicas | default("3")}}
      placement:
        constraints:
          - node.labels.DEPLOY_API == yes
    networks:
      - swarm_{{org | lower}}_{{env | lower}}
networks:
  swarm_{{org | lower}}_{{env | lower}}:
    external: true
